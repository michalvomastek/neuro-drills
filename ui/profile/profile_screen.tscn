[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/profile/profile_screen.gd" id="1_profile"]

[node name="ProfileScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_profile")

[node name="Margin" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 32

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Panel/VBox"]
layout_mode = 2

[node name="Titles" type="VBoxContainer" parent="Margin/Panel/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TitleLabel" type="Label" parent="Margin/Panel/VBox/Header/Titles"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 32
text = "PROFILE_TITLE"

[node name="SubtitleLabel" type="Label" parent="Margin/Panel/VBox/Header/Titles"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "PROFILE_SUBTITLE"
autowrap_mode = 3

[node name="BackButton" type="Button" parent="Margin/Panel/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
text = "COMMON_BACK"

[node name="Stats" type="HFlowContainer" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 6

[node name="WeekLabel" type="Label" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
autowrap_mode = 3

[node name="Separator" type="HSeparator" parent="Margin/Panel/VBox"]
layout_mode = 2

[node name="BadgesTitle" type="Label" parent="Margin/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"

[node name="Scroll" type="ScrollContainer" parent="Margin/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Badges" type="GridContainer" parent="Margin/Panel/VBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
columns = 3

[node name="Footer" type="HBoxContainer" parent="Margin/Panel/VBox"]
layout_mode = 2

[node name="Spacer" type="Control" parent="Margin/Panel/VBox/Footer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ProgressButton" type="Button" parent="Margin/Panel/VBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "MENU_PROGRESS"
