[node name="Buttons" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MenuButton" type="Button" parent="Center/Panel/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "COMMON_MENU"

[node name="Spacer" type="Control" parent="Center/Panel/VBox/Buttons"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SettingsButton" type="Button" parent="Center/Panel/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "RESULT_SETTINGS"

[node name="AgainButton" type="Button" parent="Center/Panel/VBox/Buttons"]
unique_name_in_owner = true
