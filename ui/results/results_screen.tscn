[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/results/results_screen.gd" id="1_results"]

[node name="ResultsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_results")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/separation = 16

[node name="HeadingLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "RESULT_TITLE"

[node name="TitleLabel" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32

[node name="Rows" type="GridContainer" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 32
theme_override_constants/v_separation = 8
